	firmware {

		scm {
			interconnects = <0x1f 0x03 0x00 0x20 0x01 0x00>;
			compatible = "qcom,scm-sc8280xp", "qcom,scm";
			phandle = <0x13f>;
			qcom,dload-mode = <0x21 0x13000>;
