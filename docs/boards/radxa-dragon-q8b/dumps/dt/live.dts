	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		linux,cma {
			linux,cma-default;
			compatible = "shared-dma-pool";
			size = <0x00 0x8000000>;
			reusable;
		};

		adsp-region@86c00000 {
			reg = <0x00 0x86c00000 0x00 0x2000000>;
			phandle = <0x81>;
			no-map;
		};

		reserved-region@80b00000 {
			reg = <0x00 0x80b00000 0x00 0x100000>;
			no-map;
		};

		reserved-region@80880000 {
			reg = <0x00 0x80880000 0x00 0x80000>;
			no-map;
		};

		reserved-region@aeb00000 {
			reg = <0x00 0xaeb00000 0x00 0x16600000>;
			no-map;
		};

		reserved-region@80000000 {
			reg = <0x00 0x80000000 0x00 0x860000>;
			no-map;
		};

		iris-iova {
			phandle = <0xbe>;
			iommu-addresses = <0x2a 0x00 0x00 0x00 0x25800000>;
		};

		cmd-db-region@80860000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x80860000 0x00 0x20000>;
			phandle = <0x140>;
			no-map;
		};

		reserved-region@85b00000 {
			reg = <0x00 0x85b00000 0x00 0xc00000>;
			no-map;
		};

		cdsp0-region@8a100000 {
			reg = <0x00 0x8a100000 0x00 0x1e00000>;
			phandle = <0xec>;
			no-map;
		};

		gpu-mem@8bf00000 {
			reg = <0x00 0x8bf00000 0x00 0x2000>;
			phandle = <0x91>;
			no-map;
		};

		smem-region@80900000 {
			compatible = "qcom,smem";
			reg = <0x00 0x80900000 0x00 0x200000>;
			phandle = <0x141>;
			no-map;
			hwlocks = <0x29 0x03>;
		};

		slpi-region@88c00000 {
			reg = <0x00 0x88c00000 0x00 0x1500000>;
			phandle = <0x7d>;
			no-map;
		};

		video-region@8c600000 {
			reg = <0x00 0x8c600000 0x00 0x700000>;
			phandle = <0xbd>;
			no-map;
		};

		reserved-region@83b00000 {
			reg = <0x00 0x83b00000 0x00 0x1700000>;
			no-map;
		};
	};

	audio-codec {
		qcom,micbias4-microvolt = <0x1b7740>;
		pinctrl-names = "default";
		qcom,mbhc-buttons-vthreshold-microvolt = <0x124f8 0x249f0 0x39dc8 0x7a120 0x7a120 0x7a120 0x7a120 0x7a120>;
		pinctrl-0 = <0x11e>;
		qcom,micbias2-microvolt = <0x1b7740>;
		vdd-buck-supply = <0x56>;
		#sound-dai-cells = <0x01>;
		reset-gpios = <0x57 0x6a 0x01>;
		compatible = "qcom,wcd9385-codec";
		qcom,hphl-jack-type-normally-closed;
		qcom,micbias3-microvolt = <0x1b7740>;
		qcom,rx-device = <0x11f>;
		vdd-io-supply = <0x56>;
		vdd-rxtx-supply = <0x56>;
		phandle = <0x106>;
		qcom,tx-device = <0x120>;
		qcom,mbhc-headphone-vthreshold-microvolt = <0xc350>;
		qcom,micbias1-microvolt = <0x1b7740>;
		vdd-mic-bias-supply = <0xe7>;
		qcom,mbhc-headset-vthreshold-microvolt = <0x19f0a0>;
	};

	regulator-vcc-ufs {
		regulator-max-microvolt = <0x25d780>;
		regulator-min-microvolt = <0x25d780>;
		regulator-name = "vcc_ufs";
		compatible = "regulator-fixed";
		phandle = <0x74>;
		vin-supply = <0x9c>;
	};

	hdmi-connector {
		type = "a";
		compatible = "hdmi-connector";

		port {

			endpoint {
				remote-endpoint = <0x125>;
				phandle = <0x124>;
			};
		};
	};

	regulator-vdd-usb3 {
		regulator-max-microvolt = <0x4c4b40>;
		pinctrl-names = "default";
		regulator-boot-on;
		gpio = <0xe1 0x06 0x00>;
		pinctrl-0 = <0x139>;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-name = "vdd_usb3";
		startup-delay-us = <0x2bc>;
		compatible = "regulator-fixed";
		phandle = <0x25b>;
	};

	smp2p-nsp0 {
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;
		interrupts-extended = <0x2b 0x06 0x02 0x01>;
		compatible = "qcom,smp2p";
		mboxes = <0x2b 0x06 0x02>;
		qcom,smem = <0x5e 0x1b0>;

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			#interrupt-cells = <0x02>;
			phandle = <0xeb>;
			interrupt-controller;
		};

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xed>;
		};
	};
};
