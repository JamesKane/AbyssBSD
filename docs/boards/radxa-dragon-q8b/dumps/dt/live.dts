/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "Radxa Dragon Q8B";
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "radxa,dragon-q8b", "qcom,sc8280xp";
	chassis-type = "embedded";

	usb0-sbu-mux {
		pinctrl-names = "default";
		orientation-switch;
		select-gpios = <0x57 0xa4 0x00>;
		pinctrl-0 = <0x12c>;
		compatible = "pericom,pi3usb102", "gpio-sbu-mux";
		mode-switch;
		enable-gpios = <0x57 0x65 0x01>;

		port {

			endpoint {
				remote-endpoint = <0x12d>;
				phandle = <0x128>;
			};
		};
	};

	pmic-glink {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		orientation-gpios = <0x57 0xa6 0x00 0x57 0x31 0x00>;
		compatible = "radxa,batteryless-pmic-glink", "qcom,sc8280xp-pmic-glink", "qcom,pmic-glink";

		connector@1 {
			power-role = "dual";
			data-role = "dual";
			compatible = "usb-c-connector";
			reg = <0x01>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x129>;
						phandle = <0xb8>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x12a>;
						phandle = <0xa7>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						remote-endpoint = <0x12b>;
						phandle = <0x12f>;
					};
				};
			};
		};

		connector@0 {
			power-role = "dual";
			data-role = "dual";
			compatible = "usb-c-connector";
			reg = <0x00>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x126>;
						phandle = <0xb5>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x127>;
						phandle = <0xa2>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						remote-endpoint = <0x128>;
						phandle = <0x12d>;
					};
				};
			};
		};
	};

	regulator-vcc-1v8a {
		regulator-max-microvolt = <0x1b7740>;
		regulator-boot-on;
		gpio = <0xe1 0x04 0x00>;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <0x1b7740>;
		regulator-name = "vcc_1v8a";
		startup-delay-us = <0x3e8>;
		compatible = "regulator-fixed";
		phandle = <0x131>;
	};

	soc@0 {
		dma-ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		phandle = <0x144>;

		phy@88e5000 {
			clock-names = "ref";
			resets = <0x2c 0x2c>;
			clocks = <0x2e 0x00>;
			#phy-cells = <0x00>;
			vdda-pll-supply = <0x9a>;
			compatible = "qcom,sc8280xp-usb-hs-phy", "qcom,usb-snps-hs-5nm-phy";
			status = "okay";
			reg = <0x00 0x88e5000 0x00 0x400>;
			phandle = <0xb4>;
			vdda33-supply = <0x9c>;
			vdda18-supply = <0x9b>;
		};

		thermal-sensor@c265000 {
			#qcom,sensors = <0x10>;
			interrupts-extended = <0x7b 0x1b 0x04 0x7b 0x1d 0x04>;
			#thermal-sensor-cells = <0x01>;
			compatible = "qcom,sc8280xp-tsens", "qcom,tsens-v2";
			interrupt-names = "uplow", "critical";
			reg = <0x00 0xc265000 0x00 0x1ff 0x00 0xc223000 0x00 0x08>;
			phandle = <0x10a>;
		};

		interrupt-controller@17a00000 {
			#address-cells = <0x02>;
			#redistributor-regions = <0x01>;
			interrupts = <0x01 0x09 0x04>;
			#size-cells = <0x02>;
			redistributor-stride = <0x00 0x20000>;
			compatible = "arm,gic-v3";
			ranges;
			#interrupt-cells = <0x03>;
			reg = <0x00 0x17a00000 0x00 0x10000 0x00 0x17a60000 0x00 0x100000>;
			phandle = <0x01>;
			interrupt-controller;

			msi-controller@17a40000 {
				msi-controller;
				compatible = "arm,gic-v3-its";
				reg = <0x00 0x17a40000 0x00 0x20000>;
				phandle = <0x5c>;
				#msi-cells = <0x01>;
			};
		};

		pmu@90b6400 {
			interconnects = <0x39 0x03 0x03 0x39 0x0e 0x03>;
			interrupts = <0x00 0x245 0x04>;
			compatible = "qcom,sc8280xp-cpu-bwmon", "qcom,sdm845-bwmon";
			reg = <0x00 0x90b6400 0x00 0x600>;
			operating-points-v2 = <0xac>;

			opp-table {
				compatible = "operating-points-v2";
				phandle = <0xac>;

				opp-5 {
					opp-peak-kBps = <0xd93960>;
				};

				opp-3 {
					opp-peak-kBps = <0x8bb1b8>;
				};

				opp-1 {
					opp-peak-kBps = <0x45d6e8>;
				};

				opp-6 {
					opp-peak-kBps = <0xe8d191>;
				};

				opp-4 {
					opp-peak-kBps = <0xbba710>;
				};

				opp-2 {
					opp-peak-kBps = <0x6c7d70>;
				};

				opp-0 {
					opp-peak-kBps = <0x22e980>;
				};
			};
		};

		sram@c3f0000 {
			qcom,qmp = <0x7e>;
			compatible = "qcom,rpmh-stats";
			reg = <0x00 0xc3f0000 0x00 0x400>;
		};

		rsc@18200000 {
			power-domains = <0x25>;
			reg-names = "drv-0", "drv-1", "drv-2";
			interrupts = <0x00 0x03 0x04 0x00 0x04 0x04 0x00 0x05 0x04>;
			label = "apps_rsc";
			qcom,drv-id = <0x02>;
			compatible = "qcom,rpmh-rsc";
			qcom,tcs-offset = <0xd00>;
			reg = <0x00 0x18200000 0x00 0x10000 0x00 0x18210000 0x00 0x10000 0x00 0x18220000 0x00 0x10000>;
			phandle = <0x240>;
			qcom,tcs-config = <0x02 0x02 0x00 0x03 0x01 0x03 0x03 0x01>;

			clock-controller {
				clock-names = "xo";
				clocks = <0xe4>;
				#clock-cells = <0x01>;
				compatible = "qcom,sc8280xp-rpmh-clk";
				phandle = <0x2e>;
			};

			regulators-2 {
				vdd-l8-supply = <0xe6>;
				vdd-l1-l4-supply = <0xe8>;
				vdd-l6-l9-l10-supply = <0xe6>;
				vdd-l2-l7-supply = <0xe7>;
				compatible = "qcom,pm8350-rpmh-regulators";
				qcom,pmic-id = "d";
				vdd-l3-l5-supply = <0xe8>;

				ldo8 {
					regulator-max-microvolt = <0xdea80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0xdea80>;
					regulator-name = "vreg_l8d";
					regulator-initial-mode = <0x03>;
					phandle = <0x9e>;
				};

				ldo6 {
					regulator-max-microvolt = <0xd6d80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0xd6d80>;
					regulator-name = "vreg_l6d";
					regulator-initial-mode = <0x03>;
					phandle = <0x61>;
				};

				ldo10 {
					regulator-max-microvolt = <0xdea80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0xdea80>;
					regulator-name = "vreg_l10d";
					regulator-initial-mode = <0x03>;
					phandle = <0x9f>;
				};

				ldo4 {
					regulator-max-microvolt = <0x124f80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0x124f80>;
					regulator-name = "vreg_l4d";
					regulator-initial-mode = <0x03>;
					phandle = <0x62>;
				};

				ldo2 {
					regulator-max-microvolt = <0x2ee000>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0x2ee000>;
					regulator-name = "vreg_l2d";
					regulator-initial-mode = <0x03>;
					phandle = <0xa1>;
				};

				ldo9 {
					regulator-max-microvolt = <0xdea80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0xdea80>;
					regulator-name = "vreg_l9d";
					regulator-initial-mode = <0x03>;
					phandle = <0x9a>;
				};

				ldo7 {
					regulator-max-microvolt = <0x2ee000>;
					regulator-min-microvolt = <0x2ee000>;
					regulator-name = "vreg_l7d";
					regulator-initial-mode = <0x03>;
					phandle = <0x9c>;
				};

				ldo3 {
					regulator-max-microvolt = <0x124f80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0x124f80>;
					regulator-name = "vreg_l3d";
					regulator-initial-mode = <0x03>;
					phandle = <0x75>;
				};
			};

			regulators-0 {
				vdd-l8-supply = <0xe6>;
				vdd-l1-l4-supply = <0xe6>;
				vdd-l6-l9-l10-supply = <0xe6>;
				vdd-l2-l7-supply = <0xe7>;
				compatible = "qcom,pm8350-rpmh-regulators";
				qcom,pmic-id = "b";
				vdd-l3-l5-supply = <0xe8>;

				smps10 {
					regulator-max-microvolt = <0x1b7740>;
					regulator-boot-on;
					regulator-always-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_s10b";
					regulator-initial-mode = <0x03>;
					phandle = <0x56>;
				};

				ldo6 {
					regulator-max-microvolt = <0xd6d80>;
					regulator-allow-set-load;
					regulator-boot-on;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0xd6d80>;
					regulator-name = "vreg_l6b";
					regulator-initial-mode = <0x03>;
					phandle = <0x77>;
				};

				ldo4 {
					regulator-max-microvolt = <0xdea80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0xdea80>;
					regulator-name = "vreg_l4b";
					regulator-initial-mode = <0x03>;
					phandle = <0xa5>;
				};

				smps11 {
					regulator-max-microvolt = <0x1368c0>;
					regulator-min-microvolt = <0x1368c0>;
					regulator-name = "vreg_s11b";
					regulator-initial-mode = <0x03>;
					phandle = <0xe8>;
				};

				ldo3 {
					regulator-max-microvolt = <0x124f80>;
					regulator-allow-set-load;
					regulator-boot-on;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0x124f80>;
					regulator-name = "vreg_l3b";
					regulator-initial-mode = <0x03>;
					phandle = <0x78>;
				};

				smps12 {
					regulator-max-microvolt = <0xf03c0>;
					regulator-min-microvolt = <0xf03c0>;
					regulator-name = "vreg_s12b";
					regulator-initial-mode = <0x03>;
					phandle = <0xe6>;
				};

				ldo1 {
					regulator-max-microvolt = <0xdea80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0xdea80>;
					regulator-name = "vreg_l1b";
					regulator-initial-mode = <0x03>;
					phandle = <0x9d>;
				};
			};

			bcm-voter {
				compatible = "qcom,bcm-voter";
				phandle = <0x22>;
			};

			power-controller {
				#power-domain-cells = <0x01>;
				compatible = "qcom,sc8280xp-rpmhpd";
				phandle = <0x37>;
				operating-points-v2 = <0xe5>;

				opp-table {
					compatible = "operating-points-v2";
					phandle = <0xe5>;

					opp9 {
						opp-level = <0x180>;
						phandle = <0xbf>;
					};

					opp7 {
						opp-level = <0x140>;
						phandle = <0x243>;
					};

					opp10 {
						opp-level = <0x1a0>;
						phandle = <0xc0>;
					};

					opp5 {
						opp-level = <0xc0>;
						phandle = <0x99>;
					};

					opp3 {
						opp-level = <0x40>;
						phandle = <0x23>;
					};

					opp1 {
						opp-level = <0x10>;
						phandle = <0x241>;
					};

					opp8 {
						opp-level = <0x150>;
						phandle = <0x244>;
					};

					opp6 {
						opp-level = <0x100>;
						phandle = <0x5d>;
					};

					opp4 {
						opp-level = <0x80>;
						phandle = <0x24>;
					};

					opp2 {
						opp-level = <0x30>;
						phandle = <0x242>;
					};
				};
			};

			regulators-1 {
				vdd-l6-l9-l11-supply = <0xe7>;
				vdd-l3-l4-l5-l7-l13-supply = <0xe7>;
				vdd-l10-supply = <0xe8>;
				compatible = "qcom,pm8350c-rpmh-regulators";
				vdd-l2-l8-supply = <0xea>;
				qcom,pmic-id = "c";
				vdd-bob-supply = <0xe9>;
				vdd-l1-l12-supply = <0xea>;

				ldo8 {
					regulator-max-microvolt = <0x1b7740>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l8c";
					regulator-initial-mode = <0x03>;
					phandle = <0xa0>;
				};

				ldo6 {
					regulator-max-microvolt = <0x2d2a80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l6c";
					regulator-initial-mode = <0x03>;
					phandle = <0x98>;
				};

				bob {
					regulator-max-microvolt = <0x3c6cc0>;
					regulator-always-on;
					regulator-min-microvolt = <0x2de600>;
					regulator-name = "vreg_bob";
					regulator-initial-mode = <0x02>;
					phandle = <0xe7>;
				};

				ldo9 {
					regulator-max-microvolt = <0x2d2a80>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0x2d2a80>;
					regulator-name = "vreg_l9c";
					regulator-initial-mode = <0x03>;
					phandle = <0x97>;
				};

				ldo13 {
					regulator-max-microvolt = <0x2ee000>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0x2ee000>;
					regulator-name = "vreg_l13c";
					regulator-initial-mode = <0x03>;
					phandle = <0xa6>;
				};

				smps1 {
					regulator-max-microvolt = <0x1ccf00>;
					regulator-min-microvolt = <0x1ccf00>;
					regulator-name = "vreg_s1c";
					regulator-initial-mode = <0x03>;
					phandle = <0xea>;
				};

				ldo1 {
					regulator-max-microvolt = <0x1b7740>;
					regulator-allow-set-load;
					regulator-allowed-modes = <0x01 0x03>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l1c";
					regulator-initial-mode = <0x03>;
					phandle = <0x9b>;
				};
			};
		};

		pcie@1c20000 {
			power-domains = <0x2c 0x02>;
			pinctrl-names = "default";
			#address-cells = <0x03>;
			dma-coherent;
			interconnect-names = "pcie-mem", "cpu-pcie";
			bus-range = <0x00 0xff>;
			pinctrl-0 = <0x72>;
			clock-names = "aux", "cfg", "bus_master", "bus_slave", "slave_q2a", "ddrss_sf_tbu", "noc_aggr_4", "noc_aggr_south_sf";
			interconnects = <0x1f 0x09 0x00 0x20 0x01 0x00 0x39 0x03 0x00 0x3a 0x4d 0x00>;
			reg-names = "parf", "dbi", "elbi", "atu", "config", "mhi";
			assigned-clocks = <0x2c 0x69>;
			assigned-clock-rates = <0x124f800>;
			resets = <0x2c 0x0c 0x2c 0x0d>;
			interrupts = <0x00 0x56 0x04 0x00 0x20b 0x04 0x00 0x20c 0x04 0x00 0x20d 0x04 0x00 0x1b8 0x04>;
			clocks = <0x2c 0x69 0x2c 0x6b 0x2c 0x6c 0x2c 0x72 0x2c 0x73 0x2c 0x26 0x2c 0x09 0x2c 0x0a>;
			interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x212 0x04 0x00 0x00 0x00 0x02 0x01 0x00 0x00 0x00 0x213 0x04 0x00 0x00 0x00 0x03 0x01 0x00 0x00 0x00 0x214 0x04 0x00 0x00 0x00 0x04 0x01 0x00 0x00 0x00 0x215 0x04>;
			vddpe-3v3-supply = <0x71>;
			#size-cells = <0x02>;
			device_type = "pci";
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			num-lanes = <0x04>;
			compatible = "qcom,pcie-sc8280xp";
			ranges = <0x1000000 0x00 0x00 0x00 0x3c200000 0x00 0x100000 0x2000000 0x00 0x40000000 0x05 0x10000000 0x00 0x10000000 0x3000000 0x05 0x20000000 0x05 0x20000000 0x00 0xe0000000>;
			msi-map = <0x00 0x5c 0xa0000 0x10000>;
			#interrupt-cells = <0x01>;
			status = "okay";
			interrupt-names = "msi0", "msi1", "msi2", "msi3", "global";
			reg = <0x00 0x1c20000 0x00 0x3000 0x00 0x3c000000 0x00 0xf1d 0x00 0x3c000f20 0x00 0xa8 0x00 0x3c001000 0x00 0x1000 0x05 0x00 0x00 0x10000000 0x00 0x1c23000 0x00 0x1000>;
			linux,pci-domain = <0x02>;
			phandle = <0x19c>;
			reset-names = "pci", "link_down";
			required-opps = <0x5d>;

			pcie@0 {
				#address-cells = <0x03>;
				bus-range = <0x01 0xff>;
				#size-cells = <0x02>;
				device_type = "pci";
				reset-gpios = <0x57 0x8f 0x01>;
				ranges;
				phys = <0x32>;
				reg = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x19d>;
				wake-gpios = <0x57 0x91 0x01>;
			};
		};

		watchdog@17c10000 {
			interrupts = <0x00 0x00 0x01>;
			clocks = <0x2f>;
			compatible = "qcom,apss-wdt-sc8280xp", "qcom,kpss-wdt";
			reg = <0x00 0x17c10000 0x00 0x1000>;
		};

		iommu@14f80000 {
			dma-coherent;
			interrupts = <0x00 0x3b7 0x01 0x00 0x3bb 0x01 0x00 0x3b9 0x01>;
			#iommu-cells = <0x01>;
			compatible = "arm,smmu-v3";
			status = "reserved";
			interrupt-names = "eventq", "gerror", "cmdq-sync";
			reg = <0x00 0x14f80000 0x00 0x80000>;
			phandle = <0x23f>;
		};

		timer@17c20000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "arm,armv7-timer-mem";
			ranges = <0x00 0x00 0x00 0x20000000>;
			reg = <0x00 0x17c20000 0x00 0x1000>;

			frame@17c2b000 {
				interrupts = <0x00 0x0d 0x04>;
				frame-number = <0x05>;
				status = "disabled";
				reg = <0x17c2b000 0x1000>;
			};

			frame@17c25000 {
				interrupts = <0x00 0x0a 0x04>;
				frame-number = <0x02>;
				status = "disabled";
				reg = <0x17c25000 0x1000>;
			};

			frame@17c2d000 {
				interrupts = <0x00 0x0e 0x04>;
