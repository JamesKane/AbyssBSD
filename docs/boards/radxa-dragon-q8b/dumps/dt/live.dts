	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@300 {
			power-domains = <0x0d>;
			capacity-dmips-mhz = <0x3d5>;
			interconnects = <0x06 0x00 0x06 0x01>;
