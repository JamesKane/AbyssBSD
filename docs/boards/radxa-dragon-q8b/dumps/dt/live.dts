	sound {
		model = "SC8280XP-Radxa-Dragon-Q8B";
		audio-routing = "IN1_HPHL", "HPHL_OUT", "IN2_HPHR", "HPHR_OUT", "AMIC2", "MIC BIAS2", "TX SWR_ADC1", "ADC2_OUTPUT";
		compatible = "qcom,sc8280xp-sndcard";
		phandle = <0x251>;

		dp1-dai-link {
			link-name = "DP1 Playback";

			platform {
				sound-dai = <0x103>;
			};

			cpu {
				sound-dai = <0x102 0x81>;
			};

			codec {
				sound-dai = <0x104>;
			};
		};

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			platform {
				sound-dai = <0x103>;
