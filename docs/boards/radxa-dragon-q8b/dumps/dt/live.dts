	smp2p-nsp1 {
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x0c>;
		interrupts-extended = <0x2b 0x12 0x02 0x01>;
		compatible = "qcom,smp2p";
		mboxes = <0x2b 0x12 0x02>;
		qcom,smem = <0x269 0x268>;

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			#interrupt-cells = <0x02>;
			phandle = <0x143>;
			interrupt-controller;
		};

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x142>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	regulator-vph-pwr {
		regulator-max-microvolt = <0x325aa0>;
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "vph_pwr";
		compatible = "regulator-fixed";
		phandle = <0xe9>;
	};

	regulator-vcc-nvme2-3v3 {
		regulator-max-microvolt = <0x325aa0>;
		pinctrl-names = "default";
		gpio = <0x57 0x9e 0x00>;
		pinctrl-0 = <0x136>;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "vcc_nvme2_3v3";
		startup-delay-us = <0x5dc>;
		compatible = "regulator-fixed";
		phandle = <0x63>;
	};

	regulator-vdd-usb2 {
		regulator-max-microvolt = <0x4c4b40>;
		pinctrl-names = "default";
		regulator-boot-on;
		gpio = <0xe1 0x05 0x00>;
		pinctrl-0 = <0x138>;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-name = "vdd_usb2";
		startup-delay-us = <0x2bc>;
		compatible = "regulator-fixed";
		phandle = <0x25a>;
	};

	usb1-sbu-mux {
		pinctrl-names = "default";
		orientation-switch;
		select-gpios = <0x57 0x2f 0x00>;
		pinctrl-0 = <0x12e>;
		compatible = "pericom,pi3usb102", "gpio-sbu-mux";
		mode-switch;
		enable-gpios = <0x57 0x30 0x01>;

		port {

			endpoint {
				remote-endpoint = <0x12f>;
				phandle = <0x12b>;
			};
		};
	};

	timer {
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
		compatible = "arm,armv8-timer";
	};

	smp2p-adsp {
