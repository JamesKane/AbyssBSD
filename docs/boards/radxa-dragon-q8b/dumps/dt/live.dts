	clocks {

		sleep-clk {
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			compatible = "fixed-clock";
			phandle = <0x2f>;
		};

		xo-board-clk {
			#clock-cells = <0x00>;
			clock-frequency = <0x249f000>;
			compatible = "fixed-clock";
			phandle = <0xe4>;
		};
	};

	leds {
		pinctrl-names = "default";
		pinctrl-0 = <0x13a>;
		compatible = "gpio-leds";

		user-led {
			linux,default-trigger = "heartbeat";
			function = "status";
			color = <0x03>;
			gpios = <0x57 0x04 0x00>;
		};
	};

	psci {
		method = "smc";
		compatible = "arm,psci-1.0";

		power-domain-cpu6 {
