		codec@3370000 {
			clock-output-names = "fsgen";
			clock-names = "mclk", "macro", "dcodec", "npl";
			assigned-clocks = <0x83 0x39 0x01>;
			assigned-clock-rates = <0x124f800>;
			clocks = <0x83 0x39 0x01 0x83 0x66 0x01 0x83 0x67 0x01 0x83 0x3a 0x01>;
			qcom,dmic-sample-rate = "", "I>";
			#clock-cells = <0x00>;
			#sound-dai-cells = <0x01>;
			compatible = "qcom,sc8280xp-lpass-va-macro";
			status = "okay";
			reg = <0x00 0x3370000 0x00 0x1000>;
			phandle = <0x84>;
			vdd-micb-supply = <0x56>;
		};

		clock-controller@22100000 {
			power-domains = <0x37 0x07>;
			#reset-cells = <0x01>;
			clocks = <0x2c 0x2d 0x2e 0x00 0x00 0xf5 0x00 0xf5 0x01 0xf8 0x00 0xf8 0x01 0xfb 0x00 0xfb 0x01 0xfe 0x00 0xfe 0x01 0x00 0x00 0x00 0x00>;
			#clock-cells = <0x01>;
			#power-domain-cells = <0x01>;
			compatible = "qcom,sc8280xp-dispcc1";
			status = "disabled";
			reg = <0x00 0x22100000 0x00 0x20000>;
			phandle = <0xaa>;
		};

		cci@ac4d000 {
			power-domains = <0xc1 0x07>;
			pinctrl-names = "default", "sleep";
			#address-cells = <0x01>;
			pinctrl-0 = <0xc8>;
			clock-names = "camnoc_axi", "slow_ahb_src", "cpas_ahb", "cci";
			interrupts = <0x00 0x28a 0x01>;
			clocks = <0xc1 0x16 0xc1 0x84 0xc1 0x22 0xc1 0x1f>;
			#size-cells = <0x00>;
			compatible = "qcom,sc8280xp-cci", "qcom,msm8996-cci";
			pinctrl-1 = <0xc9>;
			status = "disabled";
			reg = <0x00 0xac4d000 0x00 0x1000>;
			phandle = <0x1be>;

			i2c-bus@0 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clock-frequency = <0xf4240>;
				reg = <0x00>;
				phandle = <0x1bf>;
			};

			i2c-bus@1 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clock-frequency = <0xf4240>;
				reg = <0x01>;
				phandle = <0x1c0>;
			};
		};

		interconnect@18590000 {
			clock-names = "xo", "alternate";
			clocks = <0x2e 0x00 0x2c 0x00>;
			#interconnect-cells = <0x01>;
			compatible = "qcom,sc8280xp-epss-l3", "qcom,epss-l3";
			reg = <0x00 0x18590000 0x00 0x1000>;
			phandle = <0x06>;
		};

		phy@88eb000 {
			power-domains = <0x2c 0x0a>;
			orientation-switch;
			clock-names = "aux", "ref", "com_aux", "usb3_pipe";
			resets = <0x2c 0x39 0x2c 0x46>;
			clocks = <0x2c 0x13d 0x2c 0x160 0x2c 0x13f 0x2c 0x140>;
			#clock-cells = <0x01>;
			vdda-phy-supply = <0x9a>;
			#phy-cells = <0x01>;
			vdda-pll-supply = <0x62>;
			compatible = "qcom,sc8280xp-qmp-usb43dp-phy";
			mode-switch;
			status = "okay";
			reg = <0x00 0x88eb000 0x00 0x4000>;
			phandle = <0x30>;
			reset-names = "phy", "common";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0xa2>;
						phandle = <0x127>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0xa3>;
						phandle = <0xb6>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						remote-endpoint = <0xa4>;
						phandle = <0xd3>;
					};
				};
			};
		};

		clock-controller@ad00000 {
			power-domains = <0x37 0x07>;
			#reset-cells = <0x01>;
			clocks = <0x2c 0x18 0x2e 0x00 0x2e 0x01 0x2f>;
			#clock-cells = <0x01>;
			#power-domain-cells = <0x01>;
			compatible = "qcom,sc8280xp-camcc";
