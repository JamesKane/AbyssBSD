			compatible = "arm,cortex-a78c";
			dynamic-power-coefficient = <0x225>;
			next-level-cache = <0x0c>;
			reg = <0x00 0x300>;
			enable-method = "psci";
			phandle = <0x1a>;
			operating-points-v2 = <0x05>;
			#cooling-cells = <0x02>;

			l2-cache {
				cache-level = <0x02>;
				cache-unified;
				compatible = "cache";
				next-level-cache = <0x07>;
				phandle = <0x0c>;
			};
		};

