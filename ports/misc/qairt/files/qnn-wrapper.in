#!/bin/sh
#
# Run one of QNN's Linux tools, or a Linux program built on QNN, on the NPU:
#	qnn TOOL [ARGS]
# TOOL is a name in /usr/local/qnn/bin (qnn-net-run, ...), one of the SDK's
# Python tools in /usr/local/qnn/sdk (qairt-converter, ...), or a path.  It
# runs under the Linux layer (the linux and qnn services, see rc.conf(5)).
#
Q=%%PREFIX%%/qnn

if [ $# -eq 0 ]; then
	echo "usage: qnn TOOL [ARGS]" >&2
	exit 64
fi
if [ "$(sysctl -n compat.linux.soc_id 2>/dev/null)" = "" ]; then
	echo "qnn: the qnn service is not running (service qnn start)" >&2
	exit 69
fi
export LD_LIBRARY_PATH="$Q/lib:%%LINUX_FASTRPC%%/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# The board, for the FastRPC library's /usr/share/qcom/conf.d lookup (the
# devicetree model it reads on Linux): SMBIOS names it on ACPI boards.
: ${MACHINE_NAME:=$(kenv -q smbios.system.product)}
export MACHINE_NAME
# The DSP-side libraries: QNN's for Hexagon v68.  The FastRPC shells are
# the board's, found through the library's configuration (conf.d).
export ADSP_LIBRARY_PATH="$Q/dsp"
export DSP_LIBRARY_PATH="$ADSP_LIBRARY_PATH"
t=$1
shift
case $t in
*/*)	exec "$t" "$@" ;;
esac
if [ -x "$Q/bin/$t" ]; then
	exec "$Q/bin/$t" "$@"
fi
# The SDK's Python tools (qairt-converter, qairt-quantizer, ...): with the
# Python 3.12 they were built for, and the SDK's modules.
if [ -f "$Q/sdk/bin/aarch64-linux/$t" ]; then
	export PYTHONPATH="$Q/sdk/lib/python${PYTHONPATH:+:$PYTHONPATH}"
	export QNN_SDK_ROOT=$Q/sdk
	exec $Q/python/bin/python3.12 "$Q/sdk/bin/aarch64-linux/$t" "$@"
fi
echo "qnn: no tool $t" >&2
exit 69
