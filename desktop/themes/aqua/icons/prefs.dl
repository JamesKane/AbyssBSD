  fill #9aa0a6
  rect w*0.18+0*(w-2*(w*0.18))*0.36 h*0.18+2*(h-2*(h*0.18))*0.36 (w-2*(w*0.18))*0.26 (h-2*(h*0.18))*0.26 1.5
  fill #9aa0a6
  rect w*0.18+1*(w-2*(w*0.18))*0.36 h*0.18+2*(h-2*(h*0.18))*0.36 (w-2*(w*0.18))*0.26 (h-2*(h*0.18))*0.26 1.5
  fill #9aa0a6
