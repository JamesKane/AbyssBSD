# Trench — the file viewer (PHASE11 P11.9). Plan Neo's materials: raised keys,
# sunken wells, brushed metal, anodized panels, glow on focus and selection
# ($gk). No Swift knows this theme; these lists are all it is.

list finder.toolbar
  rect 0 0 w h
  fill vertical stops 0 titleBarTop 1 titleBarBottom
  fill stripes 0 1 #ffffff/0.035 2 #ffffff/0
  fill stripes 0 2 #000000/0.06 5 #000000/0
  path 0 h-0.5 w h-0.5
  stroke windowBorder 1
end

list finder.back
  unless pressed rect 0 0 w h
  unless pressed fill vertical stops 0 buttonWhiteTop 1 buttonWhiteBottom
  unless pressed bevel $bevel bevelLight bevelShade
  when pressed rect 0 0 w h
  when pressed fill fieldBackground
  when pressed bevel $bevel bevelShade bevelLight
  rect 0.5 0.5 w-1 h-1
  stroke windowBorder 1
  path w/2-4 h/2 w/2+3 h/2-5 w/2+3 h/2+5 close
  unless disabled fill toolbarGlyph
  when disabled fill toolbarGlyph/0.35
end

list finder.viewswitch
  rect w/4-5 h/2-5 4 4
  and rect w/4+1 h/2-5 4 4
  and rect w/4-5 h/2+1 4 4
  and rect w/4+1 h/2+1 4 4
  unless selected fill glowFocus
  when selected fill segmentGlyph
  path w*0.75-5.5 h/2-4 w*0.75+5.5 h/2-4
  and path w*0.75-5.5 h/2 w*0.75+5.5 h/2
  and path w*0.75-5.5 h/2+4 w*0.75+5.5 h/2+4
  when selected stroke glowFocus 1.6
  unless selected stroke segmentGlyph 1.6
end

list finder.header
  rect 0 0 w h
  fill vertical stops 0 titleBarTop 1 titleBarBottom
  fill stripes 0 1 #ffffff/0.035 2 #ffffff/0
  fill stripes 0 2 #000000/0.06 5 #000000/0
  path 0 h-0.5 w h-0.5
  stroke windowBorder 1
end

list finder.header.divider
  path $x+0.5 2 $x+0.5 h-2
  stroke bevelShade 1
end

list finder.welledge
  path 0 0.5 w 0.5
  stroke windowBorder 1
end

list finder.selection
  rect -3 -3 w+6 h+6
  glow glowSelect/0.5 12 $gk
  fill glowSelect/0.22
end

list finder.namefield
  rect 0 0 w h
  fill fieldBackground
  bevel $bevel bevelShade bevelLight
  rect -2 -2 w+4 h+4
  stroke glowFocus 2
  when selected rect 4-1 2 $sel+2 h-4
  when selected fill menuHighlight
end

list finder.namefield.caret
  rect $caret 2 1.5 h-4
  fill fieldCaret
end

list finder.status
  rect 0 0 w h
  fill vertical stops 0 titleBarTop 1 titleBarBottom
  fill stripes 0 1 #ffffff/0.035 2 #ffffff/0
  fill stripes 0 2 #000000/0.06 5 #000000/0
  path 0 0.5 w 0.5
  stroke windowBorder 1
end
