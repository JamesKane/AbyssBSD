# Trench — the Dock's tiles: a raised key holding the icon (PHASE11 P11.9). BeOS lineage: three-quarter perspective, a
# heavy dark outline, lit from the top left, on a soft cast shadow. Imported
# at build time from themes/trench/art/*.svg (the Plan Neo study's own icons)
# by abyss/tools/svg2dl — do not edit by hand; edit the SVG and re-import.

list dock.icon.finder
  rect 0 0 w h
  fill vertical stops 0 buttonWhiteTop 1 buttonWhiteBottom
  bevel $bevel bevelLight bevelShade
  rect 0.5 0.5 w-1 h-1
  stroke windowBorder 1
  push
  move w*0.14 h*0.12
  scale 0.72 0.72
  path w*0.88636 h*0.89773 curve w*0.88636 h*0.93287 w*0.72356 h*0.96136 w*0.52273 h*0.96136 curve w*0.3219 h*0.96136 w*0.15909 h*0.93287 w*0.15909 h*0.89773 curve w*0.15909 h*0.86258 w*0.3219 h*0.83409 w*0.52273 h*0.83409 curve w*0.72356 h*0.83409 w*0.88636 h*0.86258 w*0.88636 h*0.89773 close
