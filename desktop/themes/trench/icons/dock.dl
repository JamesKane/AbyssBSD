  path w*0.5 h*0.40909 w*0.84091 h*0.27273 w*0.84091 h*0.72727 w*0.5 h*0.86364 close
  fill rgba(0.16471, 0.12941, 0.31373, 1)
  stroke rgba(0.0902, 0.04706, 0.17255, 1) w*0.03409 round
  path w*0.21591 h*0.36818 w*0.44318 h*0.45909 w*0.44318 h*0.55682 w*0.21591 h*0.46591 close
