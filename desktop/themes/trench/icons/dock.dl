  and path w*0.29545 h*0.59773 w*0.36364 h*0.625
  fill rgba(0, 0, 0, 1)
  stroke rgba(0, 0.89804, 1, 1) w*0.04091 round
  path w*0.18636 h*0.27955 w*0.49545 h*0.15682
  fill rgba(0, 0, 0, 1)
  stroke rgba(1, 1, 1, 0.5) w*0.02273 round
