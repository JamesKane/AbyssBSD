  fill rgba(0.63922, 0.60392, 0.79608, 1)
  stroke rgba(0.0902, 0.04706, 0.17255, 1) w*0.03409 round
  path w*0.15909 h*0.27273 w*0.5 h*0.40909 w*0.5 h*0.86364 w*0.15909 h*0.72727 close
  fill linear w*0.15909 h*0.27273 w*0.15909 h*0.86364 stops 0 rgba(0.2902, 0.2549, 0.47059, 1) 1 rgba(0.12941, 0.10196, 0.25098, 1)
