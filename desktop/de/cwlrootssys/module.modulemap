// wlroots 0.19, via pkg-config. A systemLibrary rather than flags on the C
// target, because only a systemLibrary can carry `pkgConfig:` and dependent
// targets inherit its cflags/libs — the portable pattern from HANDOFF §2.29.
// The version is pinned: the dev box has 0.19 only, the guest offers 0.19 and
// 0.20, and both are 0.19.3 today (PHASE6.md §7.3).
module CWlrootsSys [system] {
    header "shim.h"
    link "wlroots-0.19"
    export *
}
